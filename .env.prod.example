# ===== 本番環境用 .env =====
# このファイルを .env.prod にコピーして値を設定
# cp .env.prod.example .env.prod

# Flask
FLASK_APP=app.py
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=ここに長いランダム文字列を設定

# MySQL
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_DATABASE=elearning
MYSQL_USER=root
MYSQL_PASSWORD=本番用の強いパスワード
MYSQL_ROOT_PASSWORD=本番用の強いパスワード

# LLM API
LLM_PROVIDER=gemini
LLM_MODEL_SCORING=gemini-3.1-flash-lite-preview
LLM_MODEL_GENERATE=gemini-3.1-flash-lite-preview
LLM_MODEL_EXPLAIN=gpt-5-mini
GOOGLE_API_KEY=your-google-api-key
OPENAI_API_KEY=your-openai-api-key

# Google Drive (video cache)
GOOGLE_DRIVE_FOLDER_ID=your-folder-id

# Oak API
OAK_API_KEY=your-oak-api-key
